Bootstrap: docker
From: rockylinux/rockylinux:9.6

%labels
    org.opencontainers.image.source https://github.com/ElmerCSC/elmerfem
    org.opencontainers.image.version 26.2.1

%post
    set -eu
    dnf -y --setopt=install_weak_deps=False install \
        cmake gcc gcc-c++ gcc-gfortran git make \
        openmpi openmpi-devel flexiblas-devel lapack
    dnf clean all
    export PATH=/usr/lib64/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/usr/lib64/openmpi/lib:${LD_LIBRARY_PATH:-}
    git clone --depth 1 --branch release-26.2.1 https://github.com/ElmerCSC/elmerfem.git /opt/elmer-src
    cmake -S /opt/elmer-src -B /opt/elmer-build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/elmer \
        -DCMAKE_C_FLAGS=-march=x86-64-v3 \
        -DCMAKE_CXX_FLAGS=-march=x86-64-v3 \
        -DCMAKE_Fortran_FLAGS=-march=x86-64-v3 \
        -DWITH_MPI=ON \
        -DWITH_ELMERGUI=OFF \
        -DWITH_ElmerIce=OFF \
        -DWITH_Mumps=OFF \
        -DWITH_Hypre=OFF \
        -DWITH_MMG=OFF \
        -DWITH_NETCDF=OFF
    cmake --build /opt/elmer-build --parallel 8
    cmake --install /opt/elmer-build
    rm -rf /opt/elmer-src /opt/elmer-build

%environment
    export ELMER_HOME=/opt/elmer
    export PATH=/opt/elmer/bin:/usr/lib64/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/opt/elmer/lib:/opt/elmer/share/elmersolver/lib:/usr/lib64/openmpi/lib:${LD_LIBRARY_PATH:-}

%test
    set -eu
    test -x /opt/elmer/bin/ElmerSolver
    test -x /opt/elmer/bin/ElmerSolver_mpi
    test -x /opt/elmer/bin/ElmerGrid
    test -x /usr/lib64/openmpi/bin/mpiexec
    test -f /opt/elmer/share/elmersolver/lib/StatElecSolveVec.so
    ! ldd /opt/elmer/bin/ElmerSolver | grep -q 'not found'
    ! ldd /opt/elmer/bin/ElmerSolver_mpi | grep -q 'not found'
    OMPI_ALLOW_RUN_AS_ROOT=1 OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
        /usr/lib64/openmpi/bin/mpiexec --oversubscribe -n 2 /bin/true

%help
    Elmer FEM 26.2.1 built for x86-64-v3 on Rocky Linux 9.6.
    ElmerGrid, ElmerSolver, and ElmerSolver_mpi are on PATH.

    Example:
        apptainer exec elmer-26.2.1-rocky9-x86_64_v3.sif ElmerGrid 14 2 model.msh -autoclean
        apptainer exec elmer-26.2.1-rocky9-x86_64_v3.sif ElmerSolver model.sif
